<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#161e2e"
                android:endColor="#131a24"
                android:angle="135"
                android:type="linear"/>
            <stroke
                android:width="1dp"
                android:color="#1e2d45"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="200dp"
        android:bottom="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#06448aff"/>
            <corners android:topLeftRadius="14dp"/>
        </shape>
    </item>
</layer-list>
