<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dlg_bg"
    android:padding="@dimen/_18sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/close_btn"
        android:background="@drawable/dlg_close_bg"
        android:padding="7dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_clear"
        app:tint="@color/dlg_text_secondary"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/dlg_icon_tile_primary"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="@dimen/_52sdp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:src="@drawable/ic_dlg_tune"
            app:tint="@color/dlg_primary"/>
    </FrameLayout>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/dlg_text_primary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/dlg_gradient_line"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/dlg_text_secondary"
        android:gravity="center"
        android:id="@+id/msg_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/dlg_btn_primary"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dlg_text_primary"
            android:id="@+id/toggle_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/count_container"
        android:background="@drawable/dlg_btn_secondary"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dlg_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/multi_float"/>
        <Spinner
            android:id="@+id/count_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/close_action"
        android:background="@drawable/dlg_btn_secondary"
        android:padding="@dimen/_10sdp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dlg_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/close"/>
    </LinearLayout>
</LinearLayout>
