<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/dlg_btn_secondary"
    android:paddingLeft="@dimen/_7sdp"
    android:paddingTop="@dimen/_5sdp"
    android:paddingRight="@dimen/_7sdp"
    android:paddingBottom="@dimen/_5sdp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_4sdp"
    android:paddingHorizontal="@dimen/_7sdp"
    android:paddingVertical="@dimen/_5sdp">
    <FrameLayout
        android:background="@drawable/dlg_icon_tile_primary"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/stream_icon"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:src="@drawable/ic_network_stream"
            app:tint="@color/dlg_primary"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/stream_logo"
            android:background="@drawable/logo_white_bg_item"
            android:padding="1dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:scaleType="fitCenter"/>
    </FrameLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/dlg_text_primary"
        android:id="@+id/stream_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/_8sdp"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/dlg_amber"
        android:id="@+id/hd_badge"
        android:background="@drawable/dlg_hd_badge"
        android:paddingLeft="@dimen/_6sdp"
        android:paddingTop="2dp"
        android:paddingRight="@dimen/_6sdp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HD"
        android:layout_marginEnd="@dimen/_4sdp"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingVertical="2dp"/>
    <ImageView
        android:layout_width="@dimen/_12sdp"
        android:layout_height="@dimen/_12sdp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/dlg_text_secondary"/>
</LinearLayout>
