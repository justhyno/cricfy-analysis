<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_splash_premium"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ly_splash"
        android:paddingLeft="@dimen/_24sdp"
        android:paddingRight="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/_24sdp">
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.8"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/_92sdp"
            android:layout_height="@dimen/_92sdp"
            app:cardBackgroundColor="@color/bgElevated"
            app:cardCornerRadius="@dimen/_24sdp"
            app:cardElevation="@dimen/_6sdp"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1dp">
            <ImageView
                android:id="@+id/splash_img"
                android:padding="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:srcCompat="@drawable/splashcricfy"/>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="@string/app_name"
            android:letterSpacing="0.08"/>
        <View
            android:background="@drawable/dlg_gradient_line"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="3dp"
            android:layout_marginTop="@dimen/_6sdp"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/splash_tagline"
            android:textAllCaps="true"
            android:letterSpacing="0.12"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/ly_offline"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:textColor="@color/white"
                    android:id="@+id/wifi_setting_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/open_wi_fi_setting"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:textColor="@color/white"
                    android:id="@+id/mobile_data_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/open_mobile_data"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:textColor="@color/white"
                    android:id="@+id/refresh_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/refresh"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
        </FrameLayout>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/anim_splash"
            android:layout_width="@dimen/_96sdp"
            android:layout_height="@dimen/_72sdp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_anim"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/version_txt"
            android:background="@drawable/bg_splash_chip"
            android:paddingLeft="@dimen/_12sdp"
            android:paddingTop="6dp"
            android:paddingRight="@dimen/_12sdp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/version_txt"
            android:textAllCaps="true"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="6dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.3"/>
    </LinearLayout>
    <include
        android:id="@+id/error_layout"
        android:visibility="gone"
        layout="@layout/error_layout"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/update_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
