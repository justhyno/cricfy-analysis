<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dlg_bg"
    android:padding="@dimen/_14sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/close_btn"
        android:background="@drawable/dlg_close_bg"
        android:padding="7dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_clear"
        app:tint="@color/dlg_text_secondary"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/dlg_icon_tile_primary"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginBottom="8dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/tg_icon"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_telegram"
            app:tint="@color/white"/>
        <ImageView
            android:id="@+id/tg_logo"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_5sdp"
            android:scaleType="fitCenter"/>
    </FrameLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/dlg_text_primary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/join_tg_title"/>
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/dlg_gradient_line"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="3dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="7dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/dlg_text_secondary"
        android:gravity="center"
        android:id="@+id/tg_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/join_tg_subtitle"
        android:lineSpacingExtra="2dp"/>
    <View
        android:background="@color/dlg_stroke"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="8dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/join_btn"
        android:background="@drawable/dlg_btn_primary"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <FrameLayout
            android:background="@drawable/dlg_icon_tile_primary"
            android:layout_width="34dp"
            android:layout_height="34dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_telegram"
                app:tint="@color/white"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/dlg_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_now"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/dlg_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_now_subtitle"/>
        </LinearLayout>
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/dlg_primary"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/later_btn"
        android:background="@drawable/dlg_btn_amber"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <FrameLayout
            android:background="@drawable/dlg_icon_tile_amber"
            android:layout_width="34dp"
            android:layout_height="34dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/dlg_amber"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/dlg_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/later"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/dlg_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remind_later_subtitle"/>
        </LinearLayout>
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/dlg_amber"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/dsa_btn"
        android:background="@drawable/dlg_btn_danger"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/dlg_icon_tile_danger"
            android:layout_width="34dp"
            android:layout_height="34dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_clear"
                app:tint="@color/dlg_danger"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/dlg_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dsa"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/dlg_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dsa_subtitle"/>
        </LinearLayout>
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/dlg_danger"/>
    </LinearLayout>
</LinearLayout>
