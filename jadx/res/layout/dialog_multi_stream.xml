<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dlg_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/header"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingRight="@dimen/_16sdp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:background="@drawable/dlg_icon_tile_primary"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginBottom="8dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/dialog_icon"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_network_stream"
                app:tint="@color/dlg_primary"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/dialog_logo"
                android:background="@drawable/logo_white_bg_header"
                android:padding="0dp"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_4sdp"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dlg_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/multiple_links_available"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dlg_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/choose_stream"/>
        <View
            android:background="@drawable/dlg_gradient_line"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <ScrollView
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:overScrollMode="never"
        android:layout_marginVertical="4dp"
        android:paddingVertical="@dimen/_3sdp"
        app:layout_constraintBottom_toTopOf="@+id/cancel_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/streams_container"
            android:paddingLeft="@dimen/_14sdp"
            android:paddingRight="@dimen/_14sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_14sdp"/>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/cancel_btn"
        android:background="@drawable/dlg_btn_secondary"
        android:padding="@dimen/_8sdp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_clear"
            android:layout_marginEnd="8dp"
            app:tint="@color/dlg_text_primary"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dlg_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
