<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingBottom="16dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/viewAccentBar"
        android:background="@drawable/bg_accent_bar"
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/btn_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_margin="@dimen/_8sdp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewAccentBar"
        app:tint="@color/white"/>
    <ScrollView
        android:orientation="vertical"
        android:paddingTop="@dimen/_40sdp"
        android:paddingBottom="@dimen/_40sdp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_40sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewAccentBar"
        app:layout_constraintVertical_bias="0.5">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/flIconContainer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_glow_ring"
                    android:layout_width="80dp"
                    android:layout_height="80dp"/>
                <FrameLayout
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="13dp"
                    android:layout_width="62dp"
                    android:layout_height="62dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_shield_star"
                        android:contentDescription="Support"
                        app:tint="@color/accent_green"/>
                </FrameLayout>
            </FrameLayout>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/bg_deep"
                android:id="@+id/tvBadge"
                android:background="@drawable/bg_badge_pill"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:text="FREE • 12H ACCESS"
                android:letterSpacing="0.12"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                app:layout_constraintEnd_toEndOf="@+id/flIconContainer"
                app:layout_constraintStart_toStartOf="@+id/flIconContainer"
                app:layout_constraintTop_toBottomOf="@+id/flIconContainer"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="28dp"
                android:text="@string/unlock_dialog_ad_title"
                android:fontFamily="sans-serif-condensed-medium"
                android:layout_marginHorizontal="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBadge"/>
            <TextView
                android:textSize="12.5sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="36dp"
                android:text="@string/unlock_ad_sub_title"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginHorizontal="36dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
            <View
                android:id="@+id/viewDivider"
                android:background="@color/divider_color"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="28dp"
                android:layout_marginHorizontal="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llSteps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewDivider">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <FrameLayout
                        android:background="@drawable/bg_step_circle"
                        android:layout_width="44dp"
                        android:layout_height="44dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_cursor_click"
                            android:contentDescription="Click"
                            app:tint="@color/accent_green"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tap"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Click Here"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginBottom="18dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Next"
                    android:alpha="0.4"
                    app:tint="@color/text_hint"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <FrameLayout
                        android:background="@drawable/bg_step_circle"
                        android:layout_width="44dp"
                        android:layout_height="44dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_timer"
                            android:contentDescription="Wait"
                            app:tint="@color/accent_amber"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Wait"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:gravity="center"
                        android:id="@+id/tvShowTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="8 seconds"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginBottom="18dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Next"
                    android:alpha="0.4"
                    app:tint="@color/text_hint"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <FrameLayout
                        android:background="@drawable/bg_step_circle"
                        android:layout_width="44dp"
                        android:layout_height="44dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_play_circle"
                            android:contentDescription="Enjoy"
                            app:tint="@color/accent_blue"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/enjoy"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:gravity="center"
                        android:id="@+id/tvAdHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="12h free"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llErrorBanner"
                android:background="@drawable/bg_error_banner"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llSteps">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_error_outline"
                    app:tint="@color/error_red"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/error_red"
                    android:id="@+id/tvErrorMsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ad_return_error"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="15sp"
                android:textColor="@color/bg_deep"
                android:gravity="center"
                android:id="@+id/btnWatchAd"
                android:background="@drawable/bg_cta_button"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:text="@string/click_here"
                android:textAllCaps="false"
                android:letterSpacing="0.03"
                android:layout_marginHorizontal="20dp"
                android:paddingHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llErrorBanner"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llTimerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnWatchAd">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_timer"
                    android:contentDescription="Timer"
                    app:tint="@color/text_hint"/>
                <TextView
                    android:textSize="10.5sp"
                    android:textColor="@color/text_hint"
                    android:id="@+id/tvTimerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ad_trigger_des"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clTelegramBox"
                android:background="@drawable/bg_telegram_box"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llTimerInfo">
                <ImageView
                    android:id="@+id/ivTelegram"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/ic_telegram"
                    android:scaleType="fitXY"
                    android:contentDescription="Telegram"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/telegram_blue"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llTgText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnTelegram"
                    app:layout_constraintStart_toEndOf="@+id/ivTelegram"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Join our Telegram"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/telegaram_des"
                        android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="11.5sp"
                    android:textColor="@color/bg_deep"
                    android:id="@+id/btnTelegram"
                    android:background="@drawable/bg_cta_button"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/join"
                    android:textAllCaps="false"
                    android:paddingHorizontal="14dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clAppPromo"
                android:background="@drawable/bg_app_promo_box"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clTelegramBox">
                <ImageView
                    android:id="@+id/ivAppLogo"
                    android:background="@drawable/bg_app_logo_circle"
                    android:padding="@dimen/_2sdp"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/splashcricfy"
                    android:contentDescription="App Logo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llAppText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnDownload"
                    app:layout_constraintStart_toEndOf="@+id/ivAppLogo"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Live sports. Any device."
                        android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="11.5sp"
                    android:textColor="@color/bg_deep"
                    android:id="@+id/btnDownload"
                    android:background="@drawable/bg_cta_button"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Download"
                    android:textAllCaps="false"
                    android:paddingHorizontal="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rippleColor="@color/ripple_dark"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
