<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dlg_bg"
    android:padding="@dimen/_14sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_140sdp"
        app:cardBackgroundColor="@color/dlg_icon_tile_bg"
        app:cardCornerRadius="14dp"
        app:strokeWidth="0dp">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@color/dlg_icon_tile_bg"
            android:scaleType="fitXY"/>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/dlg_text_primary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:maxLines="1"
        android:textAlignment="center"/>
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/dlg_gradient_line"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/dlg_text_secondary"
        android:gravity="center"
        android:id="@+id/message_txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:textAlignment="center"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp">
        <Button
            android:textStyle="bold"
            android:textColor="@color/dlg_text_primary"
            android:id="@+id/btn_cancel"
            android:background="@drawable/dlg_btn_secondary"
            android:nextFocusDown="@+id/btn_ok"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            style="@style/Widget.AppCompat.Button.Borderless"/>
        <Button
            android:textStyle="bold"
            android:textColor="@color/dlg_text_primary"
            android:id="@+id/btn_ok"
            android:background="@drawable/dlg_btn_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>
    <Button
        android:textSize="12sp"
        android:textColor="@color/dlg_danger"
        android:id="@+id/btn_ban"
        android:background="@drawable/dlg_list_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/dsa"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
