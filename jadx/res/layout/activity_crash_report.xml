<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/crashRoot"
    android:background="@drawable/bg_crash_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/crashScroll"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/crashContent"
            android:paddingTop="28dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cyanHighlight"
                android:background="@drawable/bg_crash_warning"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APP DIAGNOSTICS"
                android:drawablePadding="8dp"
                android:textAllCaps="true"
                android:fontFamily="@font/alata"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                app:drawableStartCompat="@drawable/ic_error_outline"
                app:drawableTint="@color/white"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:id="@+id/crashTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Something went wrong"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/alata"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/textSecondary"
                android:id="@+id/crashMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cricfy saved a technical report with device details and error logs. Share it with the app owner for investigation."
                android:lineSpacingExtra="3dp"
                android:fontFamily="@font/alata"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_crash_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Device and crash summary"
                    android:fontFamily="@font/alata"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:id="@+id/reportSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Crash logs"
                android:fontFamily="@font/alata"/>
            <HorizontalScrollView
                android:background="@drawable/bg_crash_logs"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fillViewport="false">
                <TextView
                    android:textSize="11sp"
                    android:textColor="#d8e2ef"
                    android:id="@+id/logsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textIsSelectable="true"
                    android:fontFamily="monospace"/>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/crashActions"
        android:background="#f20f1724"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <Button
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/shareLogsButton"
            android:background="@drawable/bg_crash_primary_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/copyLogsButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="Share"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/alata"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/textPrimary"
            android:id="@+id/copyLogsButton"
            android:background="@drawable/bg_crash_secondary_button"
            android:focusable="true"
            android:nextFocusLeft="@+id/shareLogsButton"
            android:nextFocusRight="@+id/restartButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="Copy"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/alata"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="8dp"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/textPrimary"
            android:id="@+id/restartButton"
            android:background="@drawable/bg_crash_secondary_button"
            android:focusable="true"
            android:nextFocusLeft="@+id/copyLogsButton"
            android:nextFocusRight="@+id/closeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="Restart"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/alata"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="8dp"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/textPrimary"
            android:id="@+id/closeButton"
            android:background="@drawable/bg_crash_secondary_button"
            android:focusable="true"
            android:nextFocusLeft="@+id/restartButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="Close"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/alata"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
